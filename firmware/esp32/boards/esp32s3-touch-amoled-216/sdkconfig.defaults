# Waveshare ESP32-S3-Touch-AMOLED-2.16: ESP32-S3R8 (8 MB octal PSRAM), 16 MB flash,
# square 480x480 CO5300 AMOLED (QSPI, MADCTL 0xA0), CST9220 touch, ES8311 + ES7210
# codecs, AXP2101 (ALDO3 powers the display). Pins: AgentTouch firmware/src/pins.h
# and the Waveshare BSP esp32_s3_touch_amoled_2_16.
CONFIG_IDF_TARGET="esp32s3"
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# The 460 KB framebuffer and audio buffers go to PSRAM.
CONFIG_SPIRAM_USE_MALLOC=y
# If PSRAM ever fails to start, boot anyway so the log and `diag` can say so.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# The USB-C port is the S3's own USB Serial/JTAG; the console must live on USB.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HG_BOARD_AMOLED_216=y

# Voice wake-up (ESP-SR WakeNet9, see main/port_wakeword.cpp): the model
# ships in the app image; the cache split below is Espressif's recommendation
# for running WakeNet on the S3.
CONFIG_SR_WN_WN9_XIAOAITONGXUE=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# The wake word model lives in a dedicated partition instead of the app slots.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/esp32s3-touch-amoled-216/partitions-216.csv"
